# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key

# Server
PORT=3001
NODE_ENV=development

# CORS — comma-separated list for multiple origins
CLIENT_URL=http://localhost:5173

# Admin — required to access GET /api/contact (view messages)
ADMIN_API_KEY=generate-a-strong-random-key-here

# Email notifications (Resend — https://resend.com)
# 1. Sign up at https://resend.com (free: 100 emails/day)
# 2. Create an API key at https://resend.com/api-keys
# 3. Use onboarding@resend.dev as FROM while testing
# 4. Add your custom domain later for production
RESEND_API_KEY=re_YOUR_API_KEY_HERE
EMAIL_FROM=onboarding@resend.dev
EMAIL_TO=your@email.com
